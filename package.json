{
  "name": "davidrhodes-io",
  "private": true,
  "version": "1.0.0",
  "description": "Personal portfolio for David Rhodes, Senior Solutions Engineer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43217 --strictPort",
    "build": "tsc -b && vite build",
